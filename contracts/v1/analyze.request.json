          "title": "Content",
          "type": "string"
        },
        "end_line": {
          "title": "End Line",
          "type": "integer"
        },
        "line": {
          "title": "Line",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "start_line": {
          "title": "Start Line",
          "type": "integer"
        }
